# Supabase
# Production Supabase variables should only exist in the production Railway environment variables.

# Staging Supabase project — the only live target of the admin-window build.
# An unset name is a refusal, never a fallback to the SUPABASE_* names above.
STAGING_SUPABASE_URL=""
STAGING_SUPABASE_SERVICE_ROLE_KEY=""
# STAGING_SUPABASE_DB_URL is read only by the kspace Scraper staging tools (tools/staging/*, tests/helpers/sweep.py); Admin never reads it.
STAGING_SUPABASE_DB_URL=

# NextAuth
AUTH_SECRET="generate-with-npx-auth-secret"
# On Railway: set AUTH_URL to your Railway public domain, e.g. https://your-app.up.railway.app
AUTH_URL="http://localhost:3000"

# OAuth Providers
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
