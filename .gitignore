# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli cache
supabase/.temp/

agenticflow/tracker/RUNNING
agenticflow/tracker/PARKED
agenticflow/tracker/.relaunch_attempts
agenticflow/tracker/SESSION_LOCK
agenticflow/tracker/HEARTBEAT
agenticflow/tracker/CLOSING
__pycache__/
.venv-tools/
agenticflow/tracker/ORCHESTRATOR_SESSION
agenticflow/tracker/ui_filings/
agenticflow/tracker/ship_invocations.tsv
agenticflow/.worktrees/
agenticflow/tracker/ci_check.lock
agenticflow/tracker/ui.url
agenticflow/visions/*/tracker/evidence/*
!agenticflow/visions/*/tracker/evidence/.gitkeep
agenticflow/tracker/evidence/*
!agenticflow/tracker/evidence/.gitkeep
*.db
*.log
*.jsonl
app/.venv/

# scanner-probe mirror trees written and removed by offline tests
tests/.probes/
